rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin allow-list: only readable/writable by an already-verified admin,
    // or manually via the Firebase Console when granting a new admin.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    match /sermons/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /liveEvents/{id}    { allow read: if true; allow write: if isAdmin(); }

    // Announcements ("community posts"): publicly readable, admin-only to
    // create/edit/delete/pin. Each device may cast (or change) one vote per
    // poll by writing its own doc, keyed by its own anonymous device id —
    // no account is required to vote.
    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();

      match /votes/{voterId} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().hasAll(["optionId", "votedAt"]) &&
                                  request.resource.data.optionId is string &&
                                  request.resource.data.votedAt is number;
        allow delete: if isAdmin();
      }
    }
    match /scriptures/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /storeItems/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /gallery/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /liveTvSchedule/{id}{ allow read: if true; allow write: if isAdmin(); }
    match /churchDetails/{id} { allow read: if true; allow write: if isAdmin(); }

    // Anyone can create a donation record after a successful payment;
    // only admins can read/update/delete the ledger.
    match /donations/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
